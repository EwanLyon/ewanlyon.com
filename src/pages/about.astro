---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";

import AboutMeImage from "../assets/about.jpg";
---

<BaseLayout title="About | Ewan Lyon" description="About Ewan Lyon">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero title="About" tagline="Nerd.">
				<Image
					width="1553"
					height="1200"
					src={AboutMeImage}
					alt="A black and white photo of Ewan Lyon with broadcast headphones on looking at a monitor off screen."
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>Love Games, Love Programming, Love Designing, Love Trains.</p>
					<p>
						Love the behind the scenes of how large events work and have had the chance to work a few with ESL Australia
						and Melbourne Melee.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>
						Swinburne University of Technology.<br />
						<ul>
							<li>Bachelor of Computer Science.</li>
							<li>Bachelor of Games and Interactivity.</li>
							<li>Major in Games Development.</li>
							<li>Minor in Visual Effects.</li>
						</ul>
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Languages</h2>
				<div class="content">
					<p>Typescript/Javascript, C#, C++, Python, HTML/CSS, Ruby, Kotlin, PHP and Visual Basic</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Frameworks</h2>
				<div class="content">
					<p>React, Node.js, Svelte, KeystoneJS, Next.js, NodeCG, Firebase and Polymer</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Software</h2>
				<div class="content">
					<p>
						Git, VSCode, Visual Studio, Microsoft Office Suite, Open Broadcaster Software, Adobe Creative Suite, Figma,
						Blender, Paint.net, Davinci Resolve, Perforce and Substance Designer
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Cloud Services</h2>
				<div class="content">
					<p>AWS, Azure, Digital Ocean, GitHub</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
