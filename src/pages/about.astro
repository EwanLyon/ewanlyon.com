---
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';

import BAMImage from '../assets/at-work.jpg';
---

<BaseLayout title="About | Ewan Lyon" description="About Ewan Lyon">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero title="About" tagline="Thanks for stopping by. Read below to learn more about myself and my background.">
				<Image
					width="1553"
					height="873"
					src={BAMImage}
					alt="Ewan Lyon working as the technical producer for Melbourne Melee at BAM12. 2022"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I've always been passionate about learning programming and design. I've been programming since I was 15
						learning web design and games programming step by step.
					</p>
					<p>
						I've been volunteering with AusSpeedruns developing their graphics, website and live event tech pipeline
						since 2020. I've also worked with ESL Australia as a camera operator and Melbourne Melee as a technical
						producer.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>
						Bachelor of Computer Science.<br />Bachelor of Games and Interactivity.<br />Major in Games Development.<br
						/>Minor in Visual Effects.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Languages</h2>
				<div class="content">
					<p>Typescript/Javascript, C#, C++, Python, HTML/CSS, Ruby, Kotlin, PHP and Visual Basic</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Frameworks</h2>
				<div class="content">
					<p>React, Node.js, Svelte, KeystoneJS, Next.js, NodeCG, Firebase and Polymer</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Software</h2>
				<div class="content">
					<p>
						Git, VSCode, Visual Studio, Microsoft Office Suite, Open Broadcaster Software, Adobe Creative Suite, Figma,
						Blender, Paint.net, Davinci Resolve, Perforce and Substance Designer
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Cloud Services</h2>
				<div class="content">
					<p>AWS, Azure, Digital Ocean, GitHub</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
