---
import Icon from './Icon.astro';
import { github, twitch, twitter, youtube } from '../settings';
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="footerContainer">
		<div class="group">
			<p>
				Designed & Developed in Melbourne with <a href="https://astro.build/">Astro</a>
				<Icon icon="rocket-launch" size="1.2em" />
				and love
				<Icon icon="heart" size="1.2em" />
			</p>
			<p>&copy; {currentYear} Ewan Lyon</p>
		</div>
		<p class="socials">
			<a href={`https://twitter.com/${twitter}`}> Twitter</a>
			<a href={`https://github.com/${github}`}> GitHub</a>
			<a href={`https://www.youtube.com/${youtube}`}> YouTube</a>
			<a href={`https://twitch.tv/${twitch}`}> Twitch</a>
		</p>
	</div>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		margin-top: auto;
		padding: 2rem 2rem 2rem;
		text-align: center;
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	footer a {
		color: var(--gray-400);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	footer a:hover,
	footer a:focus {
		text-decoration-color: currentColor;
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.group :global(svg) {
		display: inline-block;
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footerContainer {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		border-radius: 2rem;
		border: 2px solid var(--accent-dark);
		background-color: var(--gray-999);
		padding: 1rem 0;
		gap: 2rem;
	}

	@media (min-width: 50em) {
		footer {
			flex-direction: row;
			justify-content: center;
			padding: 1.4rem 5rem;
		}

		.group {
			flex-direction: row;
			gap: 1rem;
			flex-wrap: wrap;
		}

		.socials {
			justify-content: flex-end;
		}

		.footerContainer {
			flex-direction: row;
			width: 80%;
			border-radius: 999rem;
			border: 2px solid var(--accent-dark);
			background-color: var(--gray-999);
			padding: 1rem 2rem;
		}
	}
</style>
